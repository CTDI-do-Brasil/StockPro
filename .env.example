# Configurações do Banco de Dados PostgreSQL
# Você pode usar a string de conexão DATABASE_URL direta:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/controle_estoque"

# Ou os parâmetros individuais:
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="sua_senha_aqui"
PGDATABASE="controle_estoque"

# Configurações do Servidor Backend
PORT="5000"
JWT_SECRET="sua_chave_secreta_super_segura_jwt_2026"

# GEMINI_API_KEY (opcional / se utilizado)
GEMINI_API_KEY=""

# APP_URL
APP_URL="http://localhost:3000"

